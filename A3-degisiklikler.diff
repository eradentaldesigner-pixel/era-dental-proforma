+</script><script>
+/* A3 optional cloud drafts. Missing table/permissions never disable local drafts. */
+window.cfCloudDrafts=(()=>{
+const states=new Map();let timer=null;
+const suspended=()=>typeof securityDraftsBlockedFor!=='undefined'&&currentUser?.id===securityDraftsBlockedFor;
+const scope=()=>currentUser&&currentCompanyId?currentUser.id+'|'+currentCompanyId:null;
+const text=(message,key)=>{if(key!==scope())return;const el=document.getElementById('draftStatus');if(el)el.textContent=message};
+const meaningful=d=>!!d.buyerName?.trim()||d.items?.some(x=>x.desc?.trim());
+const fingerprint=d=>JSON.stringify({...d,savedAt:undefined});
+function state(key){if(!states.has(key))states.set(key,{known:false,revision:null,blocked:false,pending:null,busy:false});return states.get(key)}
+function missing(e){return ['42P01','PGRST205','42501'].includes(e?.code)}
+function failure(e,key,st){if(missing(e))st.blocked=true;text('Taslak bu cihazda kaydedildi · bulut kaydı kullanılamıyor',key)}
+async function read(key,st){const [user,company]=key.split('|');const r=await sb.from('proforma_drafts').select('payload,revision,updated_at').eq('company_id',company).eq('user_id',user).maybeSingle();if(r.error)throw r.error;if(key!==scope())return null;return r.data}
+async function flush(key){const st=state(key);if(st.busy||st.blocked||key!==scope())return;st.busy=true;try{while(st.pending&&!st.blocked&&key===scope()){const d=st.pending;st.pending=null;if(!st.known){const remote=await read(key,st);if(key!==scope())return;if(remote){st.blocked=true;text('Taslak bu cihazda kaydedildi · farklı bulut taslağı korunuyor',key);return}st.known=true;st.revision=null}const [user,company]=key.split('|'),revision=crypto.randomUUID(),body={company_id:company,user_id:user,payload:d,revision,updated_at:new Date().toISOString()};let r;if(st.revision){r=await sb.from('proforma_drafts').update(body).eq('company_id',company).eq('user_id',user).eq('revision',st.revision).select('revision').maybeSingle()}else{r=await sb.from('proforma_drafts').insert(body).select('revision').single()}if(r.error){if(r.error.code==='23505'){st.blocked=true;text('Taslak bu cihazda kaydedildi · başka cihazdaki taslak korunuyor',key);return}throw r.error}if(key!==scope())return;if(!r.data){st.blocked=true;text('Taslak bu cihazda kaydedildi · başka cihazda değiştirildi',key);return}st.revision=r.data.revision;text(st.pending?'Taslak bu cihazda kaydedildi':'Taslak kaydedildi ✓ · bulutla eşitlendi',key)}}catch(e){failure(e,key,st)}finally{st.busy=false}}
+function queue(d){const key=scope();if(suspended()||!key||!sb||d.archiveId||d.offerSnapshot?.id||!meaningful(d))return;const st=state(key);st.pending=d;if(st.blocked){text('Taslak bu cihazda kaydedildi · bulut taslağı korunuyor',key);return}clearTimeout(timer);timer=setTimeout(()=>void flush(key),1200)}
+async function restore(localRestored=false){const key=scope();if(suspended()||!key||!sb||window.cfPdfRoute||document.body.classList.contains('view-mode'))return false;const st=state(key),before=fingerprint(collectDraft());try{const remote=await read(key,st);if(key!==scope())return false;if(!remote){st.known=true;st.revision=null;return false}const d=remote.payload;if(!d||!Array.isArray(d.items)||d.archiveId||d.offerSnapshot?.id){st.blocked=true;return false}if(fingerprint(collectDraft())!==before){st.blocked=true;text('Taslak bu cihazda kaydedildi · düzenleme sırasında bulut taslağı açılmadı',key);return false}let local=null;try{local=JSON.parse(localStorage.getItem(draftKey())||'null')}catch{}if(localRestored&&local&&fingerprint(local)===fingerprint(d)){st.known=true;st.revision=remote.revision;text('Taslak kaydedildi ✓ · bulutla eşitlendi',key);return true}st.blocked=true;if(!confirm(new Date(remote.updated_at).toLocaleString('tr-TR')+' tarihli bulut taslağı açılsın mı? Mevcut cihaz taslağı yedeklenecek.')){text('Taslak bu cihazda kaydedildi · bulut taslağı korunuyor',key);return false}if(key!==scope())return false;const raw=localStorage.getItem(draftKey());if(raw)localStorage.setItem(draftKey()+':backup:'+Date.now(),raw);applyDraftData(d);localStorage.setItem(draftKey(),JSON.stringify(d));window.cfUnsaved?.saved('quote');st.pending=null;st.known=true;st.blocked=false;st.revision=remote.revision;text('Bulut taslağı açıldı ✓',key);return true}catch(e){failure(e,key,st);return false}}
